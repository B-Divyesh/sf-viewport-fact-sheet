{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["chrome", "node", "@types/chrome"]
  },
  "include": ["src", "entrypoints", "playwright-helper", "site", "wxt.config.ts"]
}
